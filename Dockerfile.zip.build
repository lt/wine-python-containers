# ZIP-based Python versions (3.5-3.14)
FROM debian:bookworm-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEARCH=win64
ENV WINEPREFIX=/wineprefix
ENV WINEDEBUG=-all
ENV WINEDLLOVERRIDES="mscoree,mshtml=d"

RUN apt-get update && apt-get install -y --no-install-recommends \
    wine wine64 wget ca-certificates gnupg unzip msitools \
    && rm -rf /var/lib/apt/lists/*

ARG PYTHON_VERSION=3.12.8
RUN mkdir /wineprefix && wine wineboot --init && wineserver -w

# Public keys for Python release managers and binary builders:
# - Larry Hastings (3.5): 97FC712E4C024BBEA48A61ED3A5CA953F73C700D
# - Ned Deily (3.6, 3.7): 0D96DF4D4110E5C43FBFB17F2D347EA6AA65421D
# - Łukasz Langa (3.8, 3.9): E3FF285672FAD07303D88F626479256114103102
# - Pablo Galindo Salgado (3.10, 3.11): A035C8C19219BA865442EB0C4C6E1EF060144985
# - Thomas Wouters (3.12, 3.13): E3EDEB8B896857236C03D35AA821E680E5FA6305
# - Steve Dower (Windows binaries): FC624643487034E5
RUN gpg --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys \
    97FC712E4C024BBEA48A61ED3A5CA953F73C700D \
    0D96DF4D4110E5C43FBFB17F2D347EA6AA65421D \
    E3FF285672FAD07303D88F626479256114103102 \
    A035C8C19219BA865442EB0C4C6E1EF060144985 \
    E3EDEB8B896857236C03D35AA821E680E5FA6305 \
    FC624643487034E5

RUN for suffix in "embed-amd64.zip" "embeddable-amd64.zip"; do \
        BASE_URL="https://www.python.org/ftp/python/$PYTHON_VERSION/python-$PYTHON_VERSION-$suffix"; \
        if wget -q --spider "$BASE_URL"; then \
            wget -q "$BASE_URL" -O python.zip && \
            wget -q "$BASE_URL.asc" -O python.zip.asc && \
            gpg --batch --verify python.zip.asc python.zip && \
            extracted=1 && break; \
        fi; \
    done; \
    if [ -z "$extracted" ]; then echo "Failed to find Python $PYTHON_VERSION"; exit 1; fi && \
    mkdir -p "$WINEPREFIX/drive_c/python" && \
    unzip python.zip -d "$WINEPREFIX/drive_c/python" && \
    rm python.zip*

# Development MSI
RUN BASE_URL="https://www.python.org/ftp/python/$PYTHON_VERSION/amd64/dev.msi"; \
    wget -q "$BASE_URL" -O dev.msi && \
    if wget -q "$BASE_URL.asc" -O dev.msi.asc; then \
        gpg --batch --verify dev.msi.asc dev.msi; \
    fi && \
    msiextract -C "$WINEPREFIX/drive_c/python" dev.msi && \
    rm dev.msi*

# Replace physical files in system32 with symlinks to the internal Wine library.
# This saves ~600MB of duplication.
RUN cd "$WINEPREFIX/drive_c/windows/system32" && \
    for f in *.dll; do \
        if [ -f "/usr/lib/x86_64-linux-gnu/wine/x86_64-windows/$f" ]; then \
            ln -sf "/usr/lib/x86_64-linux-gnu/wine/x86_64-windows/$f" "$f"; \
        fi; \
    done && \
    wineserver -w

# -----------------------------------------------------------------------------

FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEPREFIX=/wineprefix
ENV WINEARCH=win64
ENV WINEDEBUG=-all
ENV PYTHONIOENCODING=utf-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    wine64 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m wineuser && mkdir -p /wineprefix && chown wineuser:wineuser /wineprefix

COPY --from=builder --chown=wineuser:wineuser /wineprefix /wineprefix

USER wineuser
WORKDIR /wineprefix

ENTRYPOINT ["/usr/lib/wine/wine64", "/wineprefix/drive_c/python/python.exe"]

# -----------------------------------------------------------------------------

FROM runtime AS dev

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    mingw-w64 mingw-w64-tools binutils-mingw-w64-x86-64 \
    gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 make \
    && rm -rf /var/lib/apt/lists/*

ENV CC=x86_64-w64-mingw32-gcc
ENV CXX=x86_64-w64-mingw32-g++

RUN cd "$WINEPREFIX/drive_c/windows/system32" && \
    gendef "vcruntime140.dll" && \
    x86_64-w64-mingw32-dlltool -d "vcruntime140.def" -l "/usr/x86_64-w64-mingw32/lib/libvcruntime140.a" -D "vcruntime140.dll" && \
    PYTHON_DLL_PATH=$(find "$WINEPREFIX/drive_c/python" -name "python3*.dll" | grep -vE "/python3\.dll$" | head -n 1) && \
    PYTHON_DLL=$(basename "$PYTHON_DLL_PATH") && \
    cd $(dirname "$PYTHON_DLL_PATH") && \
    gendef "$PYTHON_DLL" && \
    x86_64-w64-mingw32-dlltool -d "${PYTHON_DLL%.dll}.def" -l "/usr/x86_64-w64-mingw32/lib/libpython.a" -D "$PYTHON_DLL"

USER wineuser
